# Copy this file to .env and fill in real values. Never commit .env itself.

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-to-a-random-string

# k-anonymity parameter (see docs/spec.md §3)
K_ANONYMITY_THRESHOLD=5

# Synthetic data generation
RANDOM_SEED=42
SYNTHETIC_ANOMALY_INJECTION_RATE=0.04

# Reporting portal — rate-limit token TTL in seconds (see docs/spec.md §5)
REPORT_RATE_LIMIT_TTL_SECONDS=86400
